{
  "name": "dsh-desktop-alerts",
  "version": "0.1.0",
  "description": "Windows desktop cards: get pinged when DSH needs an answer, waits for a permission decision, or finishes a turn.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preview": "node scripts/preview.mjs"
  },
